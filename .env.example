# Discord-only bridge runtime template.
# Copy to .env and fill local values.

CODEX_MODEL=gpt-5.6-terra
CODEX_SOL_MODEL=gpt-5.6-sol
CODEX_LUNA_MODEL=gpt-5.6-luna
CODEX_MAINTENANCE_MODEL=gpt-5.6-terra
CODEX_MAINTENANCE_SOL_MODEL=gpt-5.6-sol
# Daily maintenance runs Sol at `ultra`, so it delegates to the
# CODEX_SUBAGENT_MODEL below (Luna) instead of fanning out at Sol cost.
CODEX_MAINTENANCE_SOL_REASONING_EFFORT=ultra
# Sol/Terra/Luna are GPT-5.6 and accept none|low|medium|high|xhigh|max.
# `ultra` is additionally available on Sol and Terra only (per the CLI model
# catalog): it is sent to the API as `max` and turns on proactive subagent
# delegation. Luna has no ultra tier, so this value is clamped to max for Luna.
CODEX_REASONING_EFFORT=max
CODEX_REASONING_SUMMARY=auto
# Model/effort Codex uses for threads it spawns itself (the delegation `ultra`
# enables, and any explicit spawn_agent call). Empty model = inherit the root
# model, which would fan a Sol/Terra run out at Sol/Terra cost.
CODEX_SUBAGENT_MODEL=gpt-5.6-luna
CODEX_SUBAGENT_REASONING_EFFORT=max
# Safe defaults. Grant danger-full-access only to channels and jobs you trust.
CODEX_SANDBOX_MODE=workspace-write
CODEX_MAINTENANCE_SANDBOX_MODE=workspace-write
CODEX_SPARK_MODEL=gpt-5.3-codex-spark
# Spark is GPT-5.3 and rejects `max` with HTTP 400 `unsupported_value`; xhigh is
# its top tier, and a higher value here is clamped back down to xhigh.
CODEX_SPARK_REASONING_EFFORT=xhigh
CODEX_SPARK_REASONING_SUMMARY=none
CODEX_BIN=codex
# Empty means workers start in {BRIDGE_STATE_ROOT}/workspace by default.
CODEX_WORKING_DIR=
BRIDGE_CODEX_HOME=
BRIDGE_CODEX_HOME_SOURCE=
# Optional host gh login used for GitHub pushes from isolated worker HOMEs.
# Empty values are derived from HOME.
BRIDGE_HOST_HOME=
BRIDGE_GH_CONFIG_DIR=
BRIDGE_GIT_CONFIG_GLOBAL=
BRIDGE_GH_ASKPASS=
BRIDGE_PREFER_HOST_GH_CREDENTIAL=false
CODEX_QUOTA_REMAINING=
CLAUDE_QUOTA_REMAINING=
GEMINI_QUOTA_REMAINING=

# Channel-shared Python virtualenv.
# Workers put {BRIDGE_STATE_ROOT}/<channelId>_common/.venv/bin first on PATH so
# python/pip installs are shared by every thread in the same Discord channel.
CHANNEL_PYTHON_VENV_ENABLED=true
CHANNEL_PYTHON_VENV_AUTO_CREATE=false
CHANNEL_PYTHON_VENV_REQUIRED=false
CHANNEL_PYTHON_VENV_AUTO_UPGRADE=true
CHANNEL_PYTHON_BOOTSTRAP_PIP=false
CHANNEL_PYTHON_VENV_DIR=.venv
BRIDGE_PYTHON_BIN=
BRIDGE_PYTHON_CANDIDATES=python3.14,python3.13,python3.12,python3.11,python3.10,python3.9,python3.8,python3,python
BRIDGE_PIP_BOOTSTRAP_URL=https://bootstrap.pypa.io/get-pip.py

WORKER_FALLBACK_ENABLED=true
# Quota/capacity failures open a durable provider+account+model-family circuit.
# A provider-reported retry/reset time wins; these are bounded fallbacks.
WORKER_QUOTA_COOLDOWN_MS=1800000
WORKER_CAPACITY_COOLDOWN_MS=300000
WORKER_COOLDOWN_MAX_MS=86400000
DEFAULT_WORKER_CHAIN=codex,claude,antigravity,codex-spark,codex-luna
COMPANY_WORKER_CHAIN=claude,codex,antigravity,codex-spark,codex-luna
MAINTENANCE_WORKER_CHAIN=sol
MAINTENANCE_WORKER_CHAIN_ROTATION=
MAINTENANCE_WORKER_CHAIN_ROTATION_START_DATE=
# Daily maintenance is deliberately pinned to Sol at ultra reasoning; do not
# add a fallback chain for state-changing maintenance work.
COMPANY_WORKER_CHANNEL_IDS=

CLAUDE_BIN=
CLAUDE_HOME=
# Optional second Claude Code account. Claude persists OAuth/refresh tokens
# below HOME, so use a separate directory for each account. `/model` lists
# each Claude model once per account and selects both together.
CLAUDE_PRIMARY_LABEL=기본
CLAUDE_SECONDARY_HOME=
CLAUDE_SECONDARY_LABEL=보조
CLAUDE_MODEL=opus
CLAUDE_EFFORT=xhigh
CLAUDE_MAINTENANCE_MODEL=claude-fable-5
CLAUDE_MAINTENANCE_EFFORT=xhigh
CLAUDE_MAINTENANCE_FALLBACK_MODEL=claude-opus-5
CLAUDE_MAINTENANCE_FALLBACK_EFFORT=xhigh
CLAUDE_PERMISSION_MODE=default
CLAUDE_MAINTENANCE_PERMISSION_MODE=default

GEMINI_BIN=
GEMINI_HOME=
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_APPROVAL_MODE=default
GEMINI_SANDBOX=false
# Optional: enables the bridge's direct OAuth refresh for live quota probes.
# Use credentials you are authorized to use; do not commit them.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
CLAUDE_OAUTH_CLIENT_ID=

# Antigravity (Next-gen Gemini CLI)
ANTIGRAVITY_BIN=
# Keep this separate from GEMINI_HOME when Gemini and Antigravity quotas must be separate.
ANTIGRAVITY_HOME=
# Primary/fallback models for a bare `antigravity` worker-chain entry.
# Antigravity model strings are the canonical ids exposed by `agy models`.
ANTIGRAVITY_MODEL=gemini-3.7-flash-high
# `agy 1.1.9` supports low/medium/high; high is currently the maximum. The tier lives
# in the model id, and `agy` rejects `--effort` for a model that already pins one or
# has no variants at all (every Claude id, and every display-name form), so this value
# only reaches the CLI for a bare family id such as `gemini-3.7-flash`. For a pinned id
# it repoints the suffix (`gemini-3.7-flash-high` + low -> `gemini-3.7-flash-low`).
ANTIGRAVITY_FALLBACK_MODEL=gemini-3.7-flash-high
ANTIGRAVITY_EFFORT=high
# The `/model` menu's `gemini` alias selects this Antigravity profile.
ANTIGRAVITY_OPUS_MODEL=Claude Opus 4.6 (Thinking)
ANTIGRAVITY_PRO_MODEL=gemini-3.7-flash-high
ANTIGRAVITY_APPROVAL_MODE=default
ANTIGRAVITY_SANDBOX=false
ANTIGRAVITY_PREFLIGHT_TIMEOUT_MS=20000

# Empty values are derived from this checkout: PROJECT_ROOT is its parent,
# BRIDGE_REPO_ROOT is this checkout, and BRIDGE_STATE_ROOT is
# {PROJECT_ROOT}/.bridge_state.
PROJECT_ROOT=
BRIDGE_CODEX_PROJECT=
BRIDGE_REPO_ROOT=
BRIDGE_STATE_ROOT=
# Optional extra roots for explicitly targeted repo jobs. Leave empty by default;
# do not point this at the bridge repo unless every repo-enabled job should see it.
CODEX_ALLOWED_ROOTS=
# Optional ISO-8601 cutoff. When empty, a fresh process starts at the current
# time; persist a deployment timestamp here if restarts should catch up messages.
BRIDGE_IGNORE_BEFORE=
# Keep v2 during rollout preparation. Change to v3 only after the v2 queue and
# Workers are drained for the one-time cutover.
BRIDGE_RUNTIME_VERSION=v2
# v3 owns Discord/Slack connections in the stable Reception process. Use
# console for an isolated canary and live for the promoted host runtime.
V3_PLATFORM_MODE=live
# Required only for an explicit one-time v2 -> v3 promotion. Use a new unique
# value for each operator-approved attempt; a failed attempt is not retried
# automatically with the same id.
V3_PROMOTION_REQUEST_ID=
# Optional Discord thread/channel for the definitive post-health-gate result.
V3_PROMOTION_NOTIFY_DISCORD_CHANNEL_ID=
V3_STATE_ROOT=
V3_DB_PATH=
V3_RECEPTION_PORT=8793
V3_WORKBENCH_PORT=8794
V3_POLL_INTERVAL_MS=1000
V3_LEASE_TTL_MS=10000
V3_LEASE_RENEW_MS=3000
V3_WORKER_HEARTBEAT_MS=3000

# Optional per-channel secrets.
# Main bridge .env remains the default source of truth. A channel file is read only from
# {BRIDGE_STATE_ROOT}/<channelId>_common/channel.env, and only keys in this allowlist
# are injected into worker child processes. Leave CHANNEL_ENV_ALLOWLIST empty to disable.
CHANNEL_ENV_FILENAME=channel.env
CHANNEL_ENV_ALLOWLIST=
# Optional comma-separated names copied from the main process environment into
# provider CLI processes. OS basics and standard provider API credentials are
# already handled; never add bridge bot tokens or internal service credentials.
WORKER_ENV_ALLOWLIST=

DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_CHANNEL_IDS=
DISCORD_GENERAL_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=
# Keep false unless every member of the allowed channels may run agents.
DISCORD_ALLOW_ALL_USERS=false
DISCORD_THREAD_MODE=per_message
DISCORD_THREAD_FEED_MODE=final
DISCORD_THREAD_AUTO_ARCHIVE_DURATION=1440
DISCORD_GATEWAY_INTENTS=37377

# Slack Socket Mode (WebSocket, no public Request URL required).
# Slack messages use bang bridge commands such as !model, !effort, and !yolo.
SLACK_ENABLED=false
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOW_ALL_USERS=false
# Discord channel ID whose channel-common state/workspace/TODOs Slack shares.
SLACK_LOGICAL_CHANNEL_ID=
SLACK_RECONNECT_INTERVAL_MS=5000
SLACK_CATCHUP_WINDOW_MS=1800000
SLACK_OUTBOX_INTERVAL_MS=10000
SLACK_ACK_REACTION=thumbsup
SLACK_BROADCAST_TODO_ALERTS=true

BRIDGE_SINGLE_JOB_MODE=false
CODEX_MAX_CONCURRENT_JOBS=1
BACKGROUND_START_ONLY_BELOW_RUNNING=4
JOB_PROGRESS_INTERVAL_MS=60000
JOB_PROGRESS_MIN_SILENCE_MS=60000
JOB_PROGRESS_FORWARD_DELAY_MS=1000
JOB_NO_PROGRESS_KILL_MS=600000
WORKER_PROGRESS_UPDATES_ENABLED=true
JOB_COMPLETION_MARKER_MODE=inline
JOB_THREAD_LOCK_RETRY_MS=5000
ACTIVE_ASKS_ENABLED=true
ACTIVE_ASKS_TIMEOUT_MS=604800000
TODO_ALERTS_ENABLED=true
TODO_ALERTS_INTERVAL_MS=15000

# on | off | adaptive.  `adaptive` runs the nightly job only while the maintenance
# worker's remaining weekly quota is at least the fraction of the weekly window
# still left before reset (5 days to reset => needs 5/7 of the budget), so a week
# that is being spent faster than the clock defers maintenance instead of
# starving interactive work.  Unreadable quota skips the run and posts a notice
# in the general channel.
DAILY_MAINTENANCE_MODE=off
# Legacy switch; used only when DAILY_MAINTENANCE_MODE is unset.
DAILY_MAINTENANCE_ENABLED=false
DAILY_MAINTENANCE_GIT_REMOTE=origin
DAILY_MAINTENANCE_GIT_BRANCH=main
# Optional owner/repo override. When empty, the bridge derives this from the maintenance Git remote.
BRIDGE_BUG_REPORT_REPOSITORY=
DAILY_MAINTENANCE_INPUT_BUDGET_CHARS=120000
DAILY_MAINTENANCE_INLINE_ITEMS=40

DAILY_REPORTS_ENABLED=false
DAILY_REPORTS_HOUR_KST=9
# Optional official X API credential for the AI report's 24-hour trend/search/list lanes.
# Leave empty to report those X lanes as not queried; the value is never persisted in state.
X_BEARER_TOKEN=
DISCORD_ECONOMY_CHANNEL_ID=
DISCORD_AI_CHANNEL_ID=
